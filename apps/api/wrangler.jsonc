{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openuptime-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": { "crons": ["* * * * *"] },
  "routes": [{ "pattern": "status.mtcx.store/api/*", "zone_name": "mtcx.store" }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "1a4c025f1cba4c06a84dfd652e7b9fb6" }],
  "send_email": [{ "name": "EMAIL", "remote": true }],
  "vars": {
    "EMAIL_FROM": "alerts@mtcx.store",
    "INVITE_TTL_DAYS": "7",
    "BETTER_AUTH_URL": "https://status.mtcx.store",
    "WEB_ORIGIN": "https://status.mtcx.store",
    "CHECK_USER_AGENT": "OpenUptime/0.1 (+https://status.mtcx.store)"
  }
}