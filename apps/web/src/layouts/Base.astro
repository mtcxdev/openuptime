---
import "../styles/global.css";
import "../styles/mtcx-override.css";
import { ClientRouter } from "astro:transitions";
const { title = "MTCX Tools", router = true, noindex = false, description = "" } = Astro.props;
---
<!doctype html>
<html lang={Astro.locals.lang ?? "en"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/logo-180.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/icons/logo-144.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icons/logo-512.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/logo-192.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/logo-32.png" />
    <link rel="icon" href="/icons/favicon.ico" sizes="any" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    {description && <meta name="description" content={description} />}
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MTCX Tools" />
    <meta property="og:title" content={title} />
    <slot name="head" />
    <script is:inline defer src="/ou-analytics.js"></script>
    <title>{title}</title>
    {router && <ClientRouter />}
    <script is:inline>
      // Language comes from the URL (/zh-Hans/...); English is unprefixed. A visit remembers the choice in `ou_lang`,
      // and later visits to an unprefixed page jump to the remembered language. Without a remembered choice the page
      // stays English: the browser language is never used to move a visitor.
      try {
        var lm = document.cookie.match(/(?:^|; )ou_lang=([^;]+)/);
        var ck = lm ? lm[1] : "";
        var pm = location.pathname.match(/^\/(zh-Hans|ja|es)(?=\/|$)/);
        var lg = "en";
        if (pm) {
          lg = pm[1] === "zh-Hans" ? "zh-CN" : "en";
          if (ck !== "zh-CN" && pm[1] === "zh-Hans") document.cookie = "ou_lang=zh-CN;path=/;max-age=31536000;samesite=lax";
        } else {
          var pub = /^\/status(\/|$)/.test(location.pathname);
          lg = pub ? "en" : ck === "zh-CN" ? "zh-CN" : "en";
          if (lg === "zh-CN") {
            location.replace("/zh-Hans" + (location.pathname === "/" ? "" : location.pathname) + location.search + location.hash);
          }
          if (lg !== "zh-CN") lg = "en";
        }
        document.documentElement.lang = lg;
        if (pm && pm[1] === "zh-Hans") {
          // links written as /app, /login ... keep the visitor inside their language; a link with hreflang (the language
          // menu) already names its language
          var skip = /^\/(zh-Hans|ja|es|api|_astro)(\/|$|\?|#)|\.[a-z0-9]+([?#]|$)/i;
          var fix = function (a) {
            var h = a.getAttribute("href");
            if (h && !a.hasAttribute("hreflang") && h.charAt(0) === "/" && h.charAt(1) !== "/" && !skip.test(h)) a.setAttribute("href", "/zh-Hans" + (h === "/" ? "" : h));
          };
          var sweep = function (n) {
            if (n.nodeType !== 1) return;
            if (n.tagName === "A") fix(n);
            var l = n.querySelectorAll ? n.querySelectorAll("a[href]") : [];
            for (var i = 0; i < l.length; i++) fix(l[i]);
          };
          new MutationObserver(function (ms) {
            ms.forEach(function (r) {
              if (r.type === "attributes") fix(r.target);
              else r.addedNodes.forEach(sweep);
            });
          }).observe(document, { childList: true, subtree: true, attributes: true, attributeFilter: ["href"] });
          document.addEventListener("DOMContentLoaded", function () { sweep(document.documentElement); });
        }
      } catch (e) {}
      try {
        var readTheme = function () {
          var a = localStorage.getItem("ou_theme");
          var b = localStorage.getItem("mtcx-theme");
          if (a === "light" || a === "dark") return a;
          if (b === "light" || b === "dark") return b;
          return "dark";
        };
        var applyTheme = function (th, persist) {
          var v = th === "light" ? "light" : "dark";
          document.documentElement.dataset.theme = v;
          document.documentElement.style.colorScheme = v;
          if (persist) {
            try {
              localStorage.setItem("ou_theme", v);
              localStorage.setItem("mtcx-theme", v);
            } catch (e) {}
            try {
              window.dispatchEvent(new CustomEvent("mtcx-theme", { detail: v }));
            } catch (e) {}
          }
          return v;
        };
        window.__setTheme = function (next) {
          return applyTheme(next, true);
        };
        if (!document.documentElement.dataset.theme) {
          applyTheme(readTheme(), false);
        } else {
          document.documentElement.style.colorScheme = document.documentElement.dataset.theme === "light" ? "light" : "dark";
        }
      } catch (e) {}
      // soft navigation replaces <html>'s attributes: carry the theme over
      document.addEventListener("astro:before-swap", function (e) {
        try {
          var t = localStorage.getItem("ou_theme") || localStorage.getItem("mtcx-theme") || "dark";
          var v = t === "light" ? "light" : "dark";
          e.newDocument.documentElement.dataset.theme = v;
          e.newDocument.documentElement.style.colorScheme = v;
        } catch (err) {}
      });
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Epilogue:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@400;500;600;700&display=swap" />
  </head>
  <body><slot /></body>
</html>
