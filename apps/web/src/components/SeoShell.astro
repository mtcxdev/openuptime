---
import Doc from "../layouts/Doc.astro";
// Wrapper of the comparison and use-case pages: the Doc layout plus canonical / hreflang links (only when the build knows
// its public origin, like the landing pages) and FAQPage structured data.
import type { Faq } from "../lib/seo-pages";
import type { L } from "../lib/changelog";
import { faqLd, scriptJson, zhVariant } from "../lib/seo-i18n";

// The page is built in English. The Chinese title, description and FAQ data travel in the seo-i18n block, which the
// /zh-Hans route swaps in (lib/seo-i18n.ts).
const { title, description, path, faq } = Astro.props as { title: L; description: L; path: string; faq: Faq[] };
const origin = Astro.site ? Astro.site.origin : "";
const json = scriptJson(faqLd(faq, "en"));
const zh = scriptJson(zhVariant(title, description, faq));
---
<Doc title={title.en} description={description.en}>
  <Fragment slot="head">
    {origin && <link rel="canonical" href={`${origin}${path}`} />}
    {origin && <link rel="alternate" hreflang="en" href={`${origin}${path}`} />}
    {origin && <link rel="alternate" hreflang="zh-Hans" href={`${origin}/zh-Hans${path}`} />}
    {origin && <link rel="alternate" hreflang="x-default" href={`${origin}${path}`} />}
    {origin && <meta property="og:url" content={`${origin}${path}`} />}
    {origin && <meta property="og:image" content={`${origin}/og.png`} />}
    <script type="application/ld+json" id="seo-ld" set:html={json} />
    <script type="application/json" id="seo-i18n" set:html={zh} />
  </Fragment>
  <slot />
</Doc>

<style is:global>
  .docs-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 0 0 14px; }
  .doc a.docs-card { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1px solid var(--line); border-radius: var(--mtcx-radius-card, 14px); background: var(--surface); color: var(--ink); text-decoration: none; transition: border-color .15s, background-color .15s; box-shadow: var(--sh, none); }
  .doc a.docs-card:hover { border-color: var(--accent); background: var(--surface-2); }
  .docs-card b { font-family: var(--font-display, var(--sans)); font-size: 16px; font-weight: 600; letter-spacing: -.01em; }
  .docs-card span { color: var(--muted); font-size: 14px; line-height: 1.55; }
  @media (max-width: 560px) { .docs-grid { grid-template-columns: 1fr; } }
  .doc .cmp { display: block; overflow-x: auto; max-width: 100%; }
  .doc .cmp td:first-child { font-weight: 500; min-width: 120px; }
  .doc .cmp td { min-width: 180px; }
  .doc .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin: 0 0 14px; }
  .doc .two > div { border: 1px solid var(--line); border-radius: var(--mtcx-radius-card, 14px); background: var(--surface); padding: 14px 18px; box-shadow: var(--sh, none); }
  .doc .two h3 { margin-top: 0; }
  .doc .two ul { margin-bottom: 0; }
  .doc .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 14px; padding: 0; list-style: none; }
  .doc .tags li { margin: 0; font: 12px var(--mono); padding: 2px 9px; border: 1px solid var(--line-2); border-radius: 999px; color: var(--muted); }
  .doc .faq details { border-bottom: 1px solid var(--line); padding: 10px 0; }
  .doc .faq summary { cursor: pointer; font-weight: 600; }
  .doc .faq details p { margin: 8px 0 0; }
  .doc .cta { border: 1px solid var(--line); border-radius: var(--mtcx-radius-card, 14px); background: var(--surface); padding: 20px 22px; margin: 36px 0 14px; box-shadow: var(--sh, none); }
  .doc .cta h2 { border: 0; margin: 0 0 6px; padding: 0; }
  .doc .cta p { margin: 0 0 12px; }
  .doc .cta .btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .doc a.btn-s { display: inline-flex; align-items: center; height: 40px; padding: 0 16px; border-radius: var(--mtcx-radius-sm, 10px); border: 1px solid var(--line-2); color: var(--ink); text-decoration: none; font-weight: 500; transition: background-color .12s, border-color .12s, filter .12s; }
  .doc a.btn-s.primary { background: var(--mtcx-btn-primary-bg, linear-gradient(135deg, #7c5cfc, #5b3fd9)); border-color: transparent; color: #fff; box-shadow: var(--mtcx-btn-primary-shadow, 0 2px 10px rgba(124, 92, 252, .25)); }
  @media (hover: hover) { .doc a.btn-s:hover { background: var(--surface-2); border-color: var(--faint); } .doc a.btn-s.primary:hover { filter: brightness(1.06); } }
  .doc .related { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; }
  @media (max-width: 560px) { .doc .two { grid-template-columns: 1fr; } }
</style>
